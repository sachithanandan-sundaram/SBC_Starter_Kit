# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development         # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info              # debug | info | warning | error

# ── Data paths (relative to /app inside container) ──────────────────────────
DATA_DIR=data
MODELS_DIR=data/models
RECORDINGS_DIR=data/recordings
EVENTS_DIR=data/events
HLS_DIR=data/hls

# ── HLS streaming ────────────────────────────────────────────────────────────
HLS_SEGMENT_DURATION=2      # seconds per .ts segment
HLS_PLAYLIST_SIZE=6         # segments kept in live playlist

# ── Inference ────────────────────────────────────────────────────────────────
INFERENCE_MODE=mock         # mock | real

# Path to the voyager-sdk checkout INSIDE the voyager-sdk container.
# Raspberry Pi 5 + M.2 kit: /home/voyager-sdk (default, no need to set).
# Metis Compute Board: confirm with `docker exec <container> pwd` after
# `python3 start_axelera.py start ...` drops you into the SDK shell — the
# pre-built container's home directory can differ by SDK version.
VOYAGER_SDK_DIR=/home/voyager-sdk

# ── MediaMTX (runs on the HOST, not in a container, on both boards) ─────────
# The backend container reaches it via the docker bridge gateway IP.
# Verify the actual value with: docker network inspect app-net
# (look for "Gateway" under IPAM) — it is not guaranteed to be 172.18.0.1,
# especially on a fresh host where other docker networks may already exist.
MEDIAMTX_HOST=172.18.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888

# ── CORS (dev only — production is same-origin) ───────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
VOYAGER_SDK_URL=http://host.docker.internal:8001
